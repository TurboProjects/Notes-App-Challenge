# Template for backend/.envs/.local/.django
# Copy to `.django` (or run `make setup`) and fill in the secrets below.
# The real `.django` is gitignored: never commit credentials.

# General
# ------------------------------------------------------------------------------
USE_DOCKER=yes
IPYTHONDIR=/app/.ipython


# Frontend
# ------------------------------------------------------------------------------
FRONTEND_BASE_URL=http://localhost:3000


# Messaging
# ------------------------------------------------------------------------------
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//


# AI / RAG: Ask Your Notes
# ------------------------------------------------------------------------------
EMBEDDING_API_KEY=
GENERATION_API_KEY=
# Optional overrides (defaults shown):
# EMBEDDING_MODEL=text-embedding-3-small
# GENERATION_MODEL=gpt-5-nano
# EMBEDDING_VERSION=1
