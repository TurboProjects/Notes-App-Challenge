#!/bin/bash

set -o errexit
set -o pipefail
set -o nounset


python manage.py migrate
# ASGI server: required for the SSE streaming endpoints (runserver is WSGI-only).
# --reload uses watchfiles (installed) for the same DX as runserver autoreload.
exec uvicorn api.asgi:application --host 0.0.0.0 --port 8000 --reload --reload-dir /app/api
